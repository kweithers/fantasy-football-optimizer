# Required: Your ESPN Fantasy Football league ID (from the league URL)
ESPN_LEAGUE_ID=12345678

# Optional: NFL season year (defaults to current season)
ESPN_YEAR=2026

# Required: Identify your team by either numeric team ID or exact team name
ESPN_TEAM_ID=1
# ESPN_TEAM_NAME=My Fantasy Team

# Required for private leagues only (copy from browser cookies on fantasy.espn.com)
ESPN_S2=
ESPN_SWID=

# Optional: Minimum projected point gain to recommend a free agent upgrade (default: 0.5)
MIN_POINT_GAIN=0.5
